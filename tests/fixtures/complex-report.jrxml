        <defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT transaction_id, customer_id, customer_name, region, product_category, order_status, order_quantity, loyalty_points, unit_price, discount_amount, tax_amount, total_amount, order_date, shipping_date, is_vip_customer, is_delivered FROM sales_transactions WHERE order_quantity >= $P{MinOrderQuantity} ORDER BY region, order_date DESC]]>
    </queryString>
    <field name="transactionId" class="java.lang.Long"/>
    <field name="customerId" class="java.lang.String"/>
    <field name="customerName" class="java.lang.String"/>
    <field name="region" class="java.lang.String"/>
    <field name="productCategory" class="java.lang.String"/>
    <field name="orderStatus" class="java.lang.String"/>
    <field name="orderQuantity" class="java.lang.Integer"/>
    <field name="loyaltyPoints" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="discountAmount" class="java.math.BigDecimal"/>
    <field name="taxAmount" class="java.math.BigDecimal"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>
    <field name="orderDate" class="java.util.Date"/>
    <field name="shippingDate" class="java.util.Date"/>
    <field name="isVipCustomer" class="java.lang.Boolean"/>
    <field name="isDelivered" class="java.lang.Boolean"/>
    <variable name="currentCustomerName" class="java.lang.String" calculation="Nothing">
        <variableExpression><![CDATA[$F{customerName}]]></variableExpression>
    </variable>
    <variable name="groupTotalAmount" class="java.math.BigDecimal" resetType="Group" resetGroup="RegionGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{totalAmount}]]></variableExpression>
    </variable>
    <variable name="groupDiscountAmount" class="java.math.BigDecimal" resetType="Group" resetGroup="RegionGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{discountAmount} != null ? $F{discountAmount} : java.math.BigDecimal.ZERO]]></variableExpression>
    </variable>
    <variable name="groupOrderCount" class="java.lang.Integer" resetType="Group" resetGroup="RegionGroup" calculation="Count">
        <variableExpression><![CDATA[$F{transactionId}]]></variableExpression>
    </variable>
    <variable name="groupAvgQuantity" class="java.lang.Double" resetType="Group" resetGroup="RegionGroup" calculation="Average">
        <variableExpression><![CDATA[$F{orderQuantity}.doubleValue()]]></variableExpression>
    </variable>
    <variable name="grandTotalAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalAmount}]]></variableExpression>
    </variable>
    <variable name="grandTotalDiscounts" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{discountAmount} != null ? $F{discountAmount} : java.math.BigDecimal.ZERO]]></variableExpression>
    </variable>
    <variable name="totalTransactionsCount" class="java.lang.Long" calculation="Count">
